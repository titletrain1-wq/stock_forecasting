WATCHLIST=AAPL,NVDA,SPY,BTC-USD,ETH-USD
POLL_INTERVAL_CRYPTO_SEC=60
POLL_INTERVAL_EQUITY_MIN=5
BACKFILL_YEARS=5
DB_PATH=./data/app.db
RETRAIN_HOUR_UTC=22
TIINGO_API_KEY=
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# --- v2 real-time display layer (all sources keyless; no new secrets) ---
LIVE_WS_ENABLED=true
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
WS_IDLE_TIMEOUT_SEC=90
INTRADAY_EQUITY_INTERVAL=5m
INTRADAY_POLL_EQUITY_MIN=5
INTRADAY_RETENTION_DAYS=7
LIVE_FRAGMENT_REFRESH_CRYPTO_SEC=2
LIVE_FRAGMENT_REFRESH_EQUITY_SEC=15

# --- Intraday forecasting subsystem (crypto 1h/4h, separate from daily core) ---
INTRADAY_FORECAST_ENABLED=true
INTRADAY_LOOKBACK_DAYS=365
INTRADAY_BARS_HISTORY_RETENTION_DAYS=365
INTRADAY_FORECAST_WRITER_INTERVAL_SECONDS=3600
INTRADAY_EVALUATOR_INTERVAL_SECONDS=3600
INTRADAY_FORECAST_OPACITY=0.6
INTRADAY_FORECAST_COLOR_1H=#FF8C00
INTRADAY_FORECAST_COLOR_4H=#9932CC
INTRADAY_CI_LEVEL=0.95
INTRADAY_MODEL_DIR=./models/intraday

